      },
      "Fallback": {
        "Agent": "claude",
        "Model": "sonnet",
        "Effort": "medium"
      },
      "Sandbox": "workspace-write",
      "Context": "minimal",
      "Session": "resume",
      "Balance": false
    },
    "review_cross": {
      "Use": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "high"
      },
      "Fallback": {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high"
      },
      "Sandbox": "read-only",
      "Context": "project",
