{
  "SkillTests": "ask",
  "Coauthors": {
    "Enabled": true,
    "Templates": {
      "claude": "{name} \u003cnoreply@anthropic.com\u003e",
      "codex": "OpenAI Codex {model} \u003cnoreply@openai.com\u003e"
    }
  },
  "Version": 1,
  "Wire": {
    "MaxSummaryBytes": 200,
    "MaxLineBytes": 512,
    "InlineMaxBytes": 65536
  },
  "Limits": {
    "ManualOnlyModels": [
      "fable",
      "astra"
    ],
    "MaxLiveSessions": 1,
    "SelfMaxReadFiles": 3,
    "SelfMaxReadLines": 200,
    "MaxTotalSessions": 10,
    "SessionsByTier": {
      "Small": 3,
      "Medium": 5,
      "Large": 10
    },
    "SessionWaitSeconds": 60
  },
  "Models": {
    "astra": {
      "Agent": "codex",
      "Family": "astra",
      "PricedFor": "gpt-6-astra",
      "Input": 10,
      "Cached": 1,
      "Output": 50,
      "Note": ""
    },
    "fable": {
      "Agent": "claude",
      "Family": "",
      "PricedFor": "claude-fable-5-1",
      "Input": 10,
      "Cached": 0.25,
      "Output": 50,
      "Note": ""
    },
    "haiku": {
      "Agent": "claude",
      "Family": "",
      "PricedFor": "claude-haiku-5-5",
      "Input": 0.1,
      "Cached": 0.01,
      "Output": 0.5,
      "Note": "x5 above a 100K token prompt"
    },
    "luna": {
      "Agent": "codex",
      "Family": "luna",
      "PricedFor": "gpt-6-luna",
      "Input": 0.1,
      "Cached": 0.01,
      "Output": 0.5,
      "Note": ""
    },
    "opus": {
      "Agent": "claude",
      "Family": "",
      "PricedFor": "claude-opus-5-5",
      "Input": 4,
      "Cached": 0.2,
      "Output": 20,
      "Note": ""
    },
    "sol": {
      "Agent": "codex",
      "Family": "sol",
      "PricedFor": "gpt-6.1-sol",
      "Input": 2,
      "Cached": 0.1,
      "Output": 10,
      "Note": ""
    },
    "sonnet": {
      "Agent": "claude",
      "Family": "",
      "PricedFor": "claude-sonnet-5-5",
      "Input": 2,
      "Cached": 0.1,
      "Output": 10,
      "Note": ""
    },
    "terra": {
      "Agent": "codex",
      "Family": "terra",
      "PricedFor": "gpt-6.1-terra",
      "Input": 1,
      "Cached": 0.05,
      "Output": 5,
      "Note": ""
    }
  },
  "Roles": {
    "debug": {
      "Use": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "medium"
      },
      "Fallback": {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high"
      },
      "Sandbox": "read-only",
      "Context": "project",
      "Session": "resume",
      "Balance": null
    },
    "debug_hard": {
      "Use": {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high"
      },
      "Fallback": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "high"
      },
      "Sandbox": "workspace-write",
      "Context": "project",
      "Session": "resume",
      "Balance": null
    },
    "docs": {
      "Use": {
        "Agent": "claude",
        "Model": "sonnet",
        "Effort": "medium"
      },
      "Fallback": {
        "Agent": "codex",
        "Model": "terra",
        "Effort": "medium"
      },
      "Sandbox": "workspace-write",
      "Context": "minimal",
      "Session": "fresh",
      "Balance": null
    },
    "implement": {
      "Use": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "medium"
      },
      "Fallback": {
        "Agent": "claude",
        "Model": "sonnet",
        "Effort": "medium"
      },
      "Sandbox": "workspace-write",
