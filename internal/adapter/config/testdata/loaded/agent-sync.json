    },
    "review_final": {
      "Use": {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high"
      },
      "Fallback": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "high"
      },
      "Sandbox": "read-only",
      "Context": "project",
      "Session": "fresh",
      "Balance": null
    },
    "review_intermediate": {
      "Use": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "medium"
      },
      "Fallback": {
        "Agent": "claude",
        "Model": "sonnet",
        "Effort": "medium"
      },
      "Sandbox": "read-only",
      "Context": "project",
      "Session": "fresh",
      "Balance": null
    },
    "security_review": {
      "Use": {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high"
      },
      "Fallback": {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "high"
      },
      "Sandbox": "read-only",
      "Context": "project",
      "Session": "fresh",
      "Balance": null
    },
    "tests": {
      "Use": {
        "Agent": "codex",
        "Model": "terra",
        "Effort": "medium"
      },
      "Fallback": {
        "Agent": "claude",
        "Model": "sonnet",
        "Effort": "medium"
      },
      "Sandbox": "workspace-write",
      "Context": "project",
      "Session": "fresh",
      "Balance": null
    }
  },
  "Sessions": {
    "ResumeMaxInputTokens": 150000,
    "IdleCloseMinutes": 30
  },
  "Policy": {
    "OnUnmatched": "ask",
    "AskTimeoutSeconds": 120,
    "PersonAskTimeoutSeconds": 600,
    "Rules": [
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_search",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_context",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_explore",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_node",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_callers",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_callees",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_impact",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_files",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "mcp",
        "Match": "codegraph/codegraph_status",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "read",
        "Match": "**",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "read",
        "Match": "{**/.env,**/.env.*,**/*.pem,**/*.key,**/secrets/**}",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "write",
        "Match": "{**/.duolog/**,**/.git,**/.git/**}",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "write",
        "Match": "{.claude/settings*.json,.claude/hooks/**,.codex/**}",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "write",
        "Match": "**",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{go,cargo,npm,pnpm,uv,task,make} {test,lint,fmt,build}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{npm,pnpm} run {test,lint,fmt,build}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{npm,pnpm} run {type,typecheck,type:*}",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "uv run {pytest,ruff,ty,mypy,pyright,basedpyright}{, *}",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{./,}node_modules/.bin/{tsc,vue-tsc,eslint,prettier,biome,vitest,jest}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{.venv/bin/,}{pytest,ruff,black,mypy,pyright,basedpyright,ty}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{python,python3,.venv/bin/python} -m {pytest,ruff,mypy,black}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{go vet,go build,gofmt,staticcheck,golangci-lint run}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "cargo {check,clippy,fmt,nextest}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{clang-format,clang-tidy,cppcheck,ctest,cmake --build,ninja -C}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "make {check,typecheck,vet,format}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{./gradlew,gradle} --offline {test,check,build}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{./mvnw,mvn} -o {test,verify,compile}*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "dotnet {build,test} --no-restore*",
        "Decision": "allow",
        "Roles": [
          "planner",
          "implement",
          "implement_complex",
          "mechanical",
          "tests",
          "docs",
          "debug_hard"
        ],
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "git {status,diff,log,show,worktree list}*",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{cat,head,tail,ls,pwd,wc,rg,grep,find,sed,jq,stat,file,du,tree,cut,nl,comm,cmp,sort,uniq,realpath,which,basename,dirname,shasum,md5,Get-Content,Get-ChildItem,Get-Location,Test-Path,Select-String,Get-Item}*",
        "Decision": "allow",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "git {push,reset --hard,clean,rebase}*",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "rm -rf *",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{claude,codex}",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "{claude,codex} *",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "exec",
        "Match": "remove-item -recurse *",
        "Decision": "deny",
        "Roles": null,
        "ReadOnly": false
      },
      {
        "Action": "net",
        "Match": "*",
        "Decision": "ask",
        "Roles": null,
        "ReadOnly": false
      }
    ]
  },
  "Capabilities": {
    "OnMissing": {
      "Skill": "read_source",
      "MCP": "lead_first",
      "Plugin": "lead_first"
    },
    "Hints": {},
    "OnAuthFailure": "login_then_lead",
    "LoginTimeoutSeconds": 180,
    "MCPTools": {}
  },
  "Sync": {
    "Auto": true,
    "Agents": {
      "ModelMap": {
        "fable": "astra",
        "haiku": "luna",
        "opus": "sol",
        "sonnet": "terra"
      },
      "ModelRows": null,
      "DefaultEffort": {
        "fable": "high",
        "haiku": "low",
        "opus": "max",
        "sonnet": "medium"
      },
      "EffortMap": {
        "high": "high",
        "low": "low",
        "max": "max",
        "medium": "medium",
        "ultra": "max",
        "xhigh": "xhigh"
      },
      "CodexName": "underscore",
      "DropKeys": [
        "color",
        "tools"
      ],
      "Overrides": {}
    },
    "Skills": {
      "DropKeys": []
    }
  },
  "EnvPassthrough": [
    "PATH",
    "HOME",
    "USER",
    "CODEX_HOME",
    "CLAUDE_CONFIG_DIR"
  ],
  "Workers": {
    "InheritPlugins": false,
    "CompactWindow": "auto",
    "CompactLadder": {
      "max": 500000,
      "pro": 250000,
      "ultra": 700000
    }
  },
  "Lead": {
    "CompactNotes": true,
    "FreshSessionHint": 200000
  },
  "Rex": {
    "StuckNotifyMinutes": 5,
    "AutoAnswers": [
      {
        "Match": "Hooks need review",
        "Answer": "Continue without trusting"
      }
    ],
    "CaptureLines": 20,
    "StartTimeoutSeconds": 120
  },
  "Learning": {
    "Enabled": false,
    "Threshold": 2.5,
    "QualityMargin": 0.25,
    "PriorRuns": 2,
    "Uncertainty": 0.5,
    "ProfileBelowRuns": 3,
    "Judges": [
      {
        "Agent": "claude",
        "Model": "opus",
        "Effort": "high",
        "Prior": 0
      },
      {
        "Agent": "codex",
        "Model": "sol",
        "Effort": "high",
        "Prior": 0
      }
    ],
    "Classify": [
      {
        "When": {
          "role": "planner"
        },
        "Class": "feature"
      },
      {
        "When": {
          "output": "plan"
        },
        "Class": "skeleton"
      },
      {
        "When": {
          "exemplar": "no",
          "output": "code"
        },
        "Class": "skeleton"
      },
      {
        "When": {
          "output": "review",
          "target": "plan"
        },
        "Class": "plan_review"
      },
      {
        "When": {
          "outside_evidence": "yes"
        },
        "Class": "debug_multi"
      },
      {
        "When": {
          "components": "2+",
          "output": "diagnosis"
        },
        "Class": "debug_multi"
      },
      {
        "When": {
          "output": "diagnosis"
        },
        "Class": "debug"
      },
      {
        "When": {
          "output": "tests"
        },
        "Class": "tests"
      },
      {
        "When": {
          "output": "review"
        },
        "Class": "review"
      },
      {
        "When": {
          "output": "docs"
        },
        "Class": "docs"
      },
      {
        "When": {
          "role": "mechanical"
        },
        "Class": "mechanical"
      },
      {
        "When": {
          "output": "code"
        },
        "Class": "implement"
      }
    ],
    "Classes": {
      "debug": {
        "Description": "a root cause readable from one repository's code",
        "Priority": "cost",
        "Roles": [
          "debug",
          "debug_hard"
        ],
        "Ladder": [
          {
            "Agent": "codex",
            "Model": "terra",
            "Effort": "medium",
            "Prior": 2.9
          },
          {
            "Agent": "codex",
            "Model": "sol",
            "Effort": "medium",
            "Prior": 2.9
          },
          {
            "Agent": "claude",
            "Model": "opus",
            "Effort": "high",
            "Prior": 2.9
          }
        ],
        "Steps": null,
        "Rubric": [
          "correct against the tests and the brief",
          "false claims (count)"
        ],
        "Checks": null
      },
      "debug_multi": {
        "Description": "the cause spans several components or needs outside evidence such as logs, stacks or dumps",
        "Priority": "quality",
        "Roles": [
          "debug_hard"
        ],
        "Ladder": [
          {
            "Agent": "claude",
            "Model": "opus",
            "Effort": "high",
            "Prior": 2.8
          },
          {
            "Agent": "codex",
            "Model": "sol",
            "Effort": "high",
            "Prior": 2.3
          }
        ],
        "Steps": null,
        "Rubric": [
          "root cause correct and shown with evidence",
          "false claims (count)"
        ],
        "Checks": null
      },
      "docs": {
        "Description": "documentation and changelog",
        "Priority": "cost",
        "Roles": [
          "docs"
        ],
        "Ladder": [
          {
            "Agent": "claude",
            "Model": "sonnet",
            "Effort": "medium",
            "Prior": 2.9
          },
          {
            "Agent": "codex",
            "Model": "terra",
            "Effort": "medium",
            "Prior": 2.9
          }
        ],
        "Steps": null,
        "Rubric": [
          "correct against the tests and the brief",
          "false claims (count)"
        ],
        "Checks": null
      },
      "feature": {
        "Description": "a whole feature from a brief, handed to planner, which plans, implements and checks",
        "Priority": "cost",
        "Roles": [
          "planner"
        ],
        "Ladder": [
