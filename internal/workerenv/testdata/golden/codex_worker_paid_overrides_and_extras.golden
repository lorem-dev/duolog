agent: codex
shape: worker
variant: paid

env (in order; a value only where it is fixed):
  HOME
  CODEX_API_KEY
  CORP_LLM_KEY
  GOLDEN_KEEP=kept
  CODEX_PAID_EXTRA
  PATH=<EXE_DIR><PATHSEP>/usr/bin
  DUOLOG_DEPTH=1
  DUOLOG_LEAD=lead-1
  DUOLOG_ROLE=implement
  DUOLOG_RUN_ID=run-7
  MCP_TOKEN
  OPENAI_API_KEY
  GOCACHE
  GOLANGCI_LINT_CACHE
  UV_CACHE_DIR
  TMPDIR

argv prefix:
  codex
  -c
  check_for_update_on_startup=false
  -c
  model_reasoning_effort='high'
  -c
  tui.notifications=false
  -c
  shell_environment_policy.set.GOCACHE='<TMP>/duolog-go-cache/<HASH>/go-build'
  -c
  shell_environment_policy.set.GOLANGCI_LINT_CACHE='<TMP>/duolog-go-cache/<HASH>/golangci-lint'
  -c
  shell_environment_policy.set.UV_CACHE_DIR='<TMP>/duolog-go-cache/<HASH>/uv'
  -c
  shell_environment_policy.set.TMPDIR='<TMP>'

launch words:
  exec
  -s
  workspace-write
  -c
  sandbox_workspace_write.network_access=true
  -c
  sandbox_workspace_write.writable_roots=["/safe/cache"]

launch argv with run flags [--run-flag value]:
  codex
  -c
  check_for_update_on_startup=false
  -c
  model_reasoning_effort='high'
  -c
  tui.notifications=false
  -c
  shell_environment_policy.set.GOCACHE='<TMP>/duolog-go-cache/<HASH>/go-build'
  -c
  shell_environment_policy.set.GOLANGCI_LINT_CACHE='<TMP>/duolog-go-cache/<HASH>/golangci-lint'
  -c
  shell_environment_policy.set.UV_CACHE_DIR='<TMP>/duolog-go-cache/<HASH>/uv'
  -c
  shell_environment_policy.set.TMPDIR='<TMP>'
  exec
  -s
  workspace-write
  -c
  sandbox_workspace_write.network_access=true
  -c
  sandbox_workspace_write.writable_roots=["/safe/cache"]
  --run-flag
  value

claude settings (--settings):
  none

signals (name@layer):
  env:CODEX_API_KEY@env
  env:CORP_LLM_KEY@env
  env:OPENAI_API_KEY@mcp
  model_provider@user
  route:unknown-speed@user

dropped: []
endpoint entries: []
fast pinned: false
provider env key: "CORP_LLM_KEY"
cache key: 64 hex digits
