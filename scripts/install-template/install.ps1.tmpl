# Generated by scripts/render-install. Edit the template instead.
# Supports Windows PowerShell 5.1 and PowerShell 7 (pwsh).
& {
    $ErrorActionPreference = 'Stop'
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $base = 'https://github.com/{{.Owner}}/{{.Repo}}'
    # Internal test seam; not an installation option.
    if (Get-Variable DuologInstallerBaseUrl -ErrorAction SilentlyContinue) {
        $base = $DuologInstallerBaseUrl.TrimEnd('/')
    }
    $version = $env:DUOLOG_VERSION
    if (-not $version) { $version = 'latest' }
    $installDir = $env:DUOLOG_INSTALL_DIR
    if (-not $installDir) {
        if (-not $env:LOCALAPPDATA) { throw 'LOCALAPPDATA is not set' }
        $installDir = Join-Path $env:LOCALAPPDATA 'Programs\{{.BinaryName}}'
    }
    $archName = $env:PROCESSOR_ARCHITEW6432
    if (-not $archName) { $archName = $env:PROCESSOR_ARCHITECTURE }
    switch ($archName) {
        'AMD64' { $arch = 'amd64' }
        'ARM64' { $arch = 'arm64' }
        default { throw "No prebuilt binary for architecture $archName" }
    }
    if ($version -eq 'latest') {
        $response = Invoke-WebRequest -UseBasicParsing -Method Head -Uri "$base/releases/latest"
        $resolved = $response.BaseResponse.ResponseUri
        if (-not $resolved) { $resolved = $response.BaseResponse.RequestMessage.RequestUri }
        $version = $resolved.Segments[-1]
        if (-not $version -or $version -eq 'latest') { throw 'Cannot resolve latest release' }
    }
    if ($version -notmatch '^v?[0-9][0-9A-Za-z.+-]*$') { throw 'Invalid release version' }
    if (-not $version.StartsWith('v')) { $version = "v$version" }
    $archive = '{{.BinaryName}}_' + $version.TrimStart('v') + "_windows_$arch.zip"
    $prefix = "$base/releases/download/$version"
    $workDir = Join-Path ([IO.Path]::GetTempPath()) ([IO.Path]::GetRandomFileName())
    $staged = $null
    try {
        $null = New-Item -ItemType Directory -Path $workDir
        $zipPath = Join-Path $workDir $archive
        $checksums = Join-Path $workDir 'checksums.txt'
        Invoke-WebRequest -UseBasicParsing -Uri "$prefix/$archive" -OutFile $zipPath
        Invoke-WebRequest -UseBasicParsing -Uri "$prefix/checksums.txt" -OutFile $checksums
        $expected = @()
        foreach ($line in Get-Content -LiteralPath $checksums) {
            if ($line -match '^([0-9a-fA-F]{64})\s+\*?(.+)$') {
                if ($Matches[2] -ceq $archive) { $expected += $Matches[1] }
            }
        }
        if ($expected.Count -ne 1) { throw "Missing or ambiguous checksum for $archive" }
        $actual = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA256).Hash
        if ($actual -ine $expected[0]) { throw 'SHA-256 checksum mismatch' }
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        $zip = [IO.Compression.ZipFile]::OpenRead($zipPath)
        try {
            $entries = @($zip.Entries | Where-Object { $_.FullName -ceq '{{.BinaryName}}.exe' })
            if ($entries.Count -ne 1 -or $entries[0].Length -eq 0) {
                throw 'Archive has no regular binary'
            }
            $payload = Join-Path $workDir '{{.BinaryName}}.exe'
            [IO.Compression.ZipFileExtensions]::ExtractToFile($entries[0], $payload)
        } finally { $zip.Dispose() }
        $null = New-Item -ItemType Directory -Force -Path $installDir
        $staged = Join-Path $installDir ([IO.Path]::GetRandomFileName())
        [IO.File]::Copy($payload, $staged)
        $target = Join-Path $installDir '{{.BinaryName}}.exe'
        # Replace atomically: a failed replacement leaves the old file intact.
        if (Test-Path -LiteralPath $target) {
            [IO.File]::Replace($staged, $target, $null)
        } else {
            [IO.File]::Move($staged, $target)
        }
        $staged = $null
        Write-Output "Installed {{.BinaryName}} $version to $target"
        Write-Output "Add $installDir to PATH in Windows Environment Variables."
        Write-Output 'Open a new terminal, then: duolog install --scope project'
    } finally {
        if ($staged -and (Test-Path -LiteralPath $staged)) {
            Remove-Item -LiteralPath $staged -Force
        }
        if (Test-Path -LiteralPath $workDir) {
            Remove-Item -LiteralPath $workDir -Recurse -Force
        }
    }
}
