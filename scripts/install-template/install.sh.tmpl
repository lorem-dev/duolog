#!/bin/sh
# Generated by scripts/render-install. Edit the template instead.
set -eu
OWNER="{{.Owner}}"
REPO="{{.Repo}}"
BINARY="{{.BinaryName}}"
GO_MODULE="{{.GoModulePath}}"
SUPPORTED_PLATFORMS="{{.SupportedPlatforms}}"
VERSION="${DUOLOG_VERSION:-latest}"
INSTALL_DIR="${DUOLOG_INSTALL_DIR:-$HOME/.local/bin}"
VIA_GO=0
err() { printf 'error: %s\n' "$*" >&2; exit 1; }
fallback() {
    printf '%s\n' "$*" >&2
    printf 'Run: go install %s@%s\n' "$GO_MODULE" "$VERSION"
    exit 1
}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --version|--dir)
            [ "$#" -ge 2 ] || err "$1 needs a value"
            case "$1" in
                --version) VERSION="$2" ;;
                --dir) INSTALL_DIR="$2" ;;
            esac
            shift 2 ;;
        --version=*) VERSION="${1#*=}"; shift ;;
        --dir=*) INSTALL_DIR="${1#*=}"; shift ;;
        --via-go) VIA_GO=1; shift ;;
        -h|--help)
            cat <<HELP
Usage: install.sh [--version VERSION] [--dir DIR] [--via-go] [-h]
DUOLOG_VERSION defaults to latest; DUOLOG_INSTALL_DIR to ~/.local/bin.
--via-go prints the go install command and exits non-zero.
HELP
            exit 0 ;;
        *) err "unknown option: $1" ;;
    esac
done
[ -n "$VERSION" ] && [ -n "$INSTALL_DIR" ] || err 'version and dir must not be empty'
[ "$VIA_GO" -eq 0 ] || fallback '--via-go requested'
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$OS" in
    mingw*|msys*|cygwin*|windows*) fallback 'Windows is not supported by this script.' ;;
    linux|darwin) ;;
    *) fallback "No prebuilt binary for OS $OS" ;;
esac
RAW_ARCH=$(uname -m)
case "$RAW_ARCH" in
    x86_64|amd64) ARCH=amd64 ;;
    aarch64|arm64) ARCH=arm64 ;;
    *) fallback "No prebuilt binary for arch $RAW_ARCH" ;;
esac
case " $SUPPORTED_PLATFORMS " in
    *" $OS-$ARCH "*) ;;
    *) fallback "No prebuilt binary for $OS-$ARCH" ;;
esac
for tool in curl tar mktemp awk chmod mv; do
    command -v "$tool" >/dev/null 2>&1 || err "missing required tool: $tool"
done
if command -v sha256sum >/dev/null 2>&1; then
    SHA256_CMD=sha256sum
elif command -v shasum >/dev/null 2>&1; then
    SHA256_CMD='shasum -a 256'
else
    err 'need sha256sum or shasum'
fi
case "$VERSION" in
    latest|v[0-9]*) ;;
    [0-9]*) VERSION="v$VERSION" ;;
    *) err "not a release version: $VERSION" ;;
esac
case "$VERSION" in
    *[!0-9A-Za-z.+-]*) err "not a release version: $VERSION" ;;
esac
if [ "$VERSION" = latest ]; then
    RESOLVED=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
        "https://github.com/$OWNER/$REPO/releases/latest") || err 'cannot resolve latest release'
    VERSION=${RESOLVED##*/}
    [ -n "$VERSION" ] && [ "$VERSION" != latest ] || err 'cannot resolve latest tag'
fi
PREFIX="https://github.com/$OWNER/$REPO/releases/download/$VERSION"
ARCHIVE="${BINARY}_${VERSION#v}_${OS}_${ARCH}.tar.gz"
WORK_DIR=$(mktemp -d)
STAGED=''
cleanup() {
    rm -rf "$WORK_DIR"
    if [ -n "$STAGED" ]; then rm -f "$STAGED"; fi
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
curl -fsSL -o "$WORK_DIR/$ARCHIVE" "$PREFIX/$ARCHIVE" || fallback "No prebuilt binary downloaded for $OS-$ARCH"
curl -fsSL -o "$WORK_DIR/checksums.txt" "$PREFIX/checksums.txt" || err 'checksums download failed'
EXPECTED=$(awk -v name="$ARCHIVE" '$2==name || $2=="*"name {print $1; exit}' "$WORK_DIR/checksums.txt")
[ -n "$EXPECTED" ] || err "missing checksum for $ARCHIVE"
ACTUAL=$($SHA256_CMD "$WORK_DIR/$ARCHIVE" | awk '{print $1}')
[ "$EXPECTED" = "$ACTUAL" ] || err 'SHA-256 checksum mismatch'
tar -xzf "$WORK_DIR/$ARCHIVE" -C "$WORK_DIR" "$BINARY"
[ -f "$WORK_DIR/$BINARY" ] && [ ! -L "$WORK_DIR/$BINARY" ] || err 'archive has no regular binary'
if [ -x "$INSTALL_DIR/$BINARY" ]; then
    EXISTING=$("$INSTALL_DIR/$BINARY" version 2>/dev/null || true)
    if [ "${EXISTING#v}" = "${VERSION#v}" ]; then
        printf '%s %s is already current at %s\n' "$BINARY" "$VERSION" "$INSTALL_DIR/$BINARY"
    else
        printf 'Updating %s from %s to %s\n' "$BINARY" "$EXISTING" "$VERSION"
    fi
fi
mkdir -p "$INSTALL_DIR"
STAGED=$(mktemp "$INSTALL_DIR/.duolog.XXXXXX")
cp "$WORK_DIR/$BINARY" "$STAGED"
chmod 755 "$STAGED"
mv -f "$STAGED" "$INSTALL_DIR/$BINARY"
STAGED=''
printf 'Installed %s %s to %s\n' "$BINARY" "$VERSION" "$INSTALL_DIR/$BINARY"
case ":${PATH:-}:" in
    *":$INSTALL_DIR:"*) ;;
    *) printf 'warning: %s is not on PATH; add it to PATH to run duolog.\n' "$INSTALL_DIR" >&2 ;;
esac
printf 'Next: duolog install --scope project\n'
