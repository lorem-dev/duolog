root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two spaces at the end of a line are a Markdown line break, so an editor must
# not remove them. max_line_length matches docs_test.go. Keep the two in step.
[*.md]
trim_trailing_whitespace = false
indent_size = 4
max_line_length = 80

[{*.go,Makefile}]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
