{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "gate",
              "--agent",
              "claude",
              "--event",
              "PermissionRequest"
            ],
            "timeout": 630,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "PostToolUse",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "PreCompact",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "gate",
              "--agent",
              "claude",
              "--event",
              "PreToolUse"
            ],
            "timeout": 630,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "SessionEnd",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "SessionStart",
              "--agent",
              "claude"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "wake",
              "--agent",
              "claude"
            ],
            "asyncRewake": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "Stop",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "duolog",
            "args": [
              "hook",
              "UserPromptSubmit",
              "--agent",
              "claude"
            ]
          }
        ]
      }
    ]
  }
}
